#!/usr/bin/env bash

set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "$PROJECT_ROOT"

if command -v docker >/dev/null 2>&1 && docker image inspect poa-dev:local >/dev/null 2>&1; then
  echo "Building site in poa-dev:local container..."
  docker run --rm -v "$PWD:/app" -w /app poa-dev:local ./bin/build
else
  echo "poa-dev:local container not found — building with local bundle..."
  bundle exec ./bin/build
fi

echo "Pushing master to origin (GitHub Actions deploys build/ to gh-pages)..."
git push origin master

echo "✅ Done — site will be live at https://aikido-polska.eu/ after the Actions run."
echo "   Watch it: gh run watch --repo gotar/POA"
