#!/usr/bin/env bash
# Local deploy path (owner policy 2026-08-23): GitHub Actions is not part of
# the default flow. Build in poa-dev:local, push build/ to gh-pages, then poll
# the live site until the new stylesheet version appears (Pages + CDN lag 1-3 min).
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

if command -v docker >/dev/null 2>&1 && docker image inspect poa-dev:local >/dev/null 2>&1; then
  echo "Building site in poa-dev:local container..."
  sg docker -c 'docker run --rm -v "$PWD:/app" -w /app poa-dev:local ./bin/build'
else
  echo "poa-dev:local container not found — building with local bundle..."
  bundle exec ./bin/build
fi

# Expected stylesheet version, read from the fresh build before we leave the tree.
EXPECTED="$(grep -o 'assets/style.css?v=[0-9a-f]*' "$PROJECT_ROOT/build/index.html" | head -1 | sed 's/.*v=//' || true)"

echo "Pushing generated build/ to gh-pages..."
tmpdir="$(mktemp -d)"
cleanup() { git worktree remove "$tmpdir" --force >/dev/null 2>&1 || true; }
trap cleanup EXIT

git fetch origin gh-pages:refs/remotes/origin/gh-pages
git worktree add "$tmpdir" refs/remotes/origin/gh-pages

find "$tmpdir" -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +
cp -a ./build/. "$tmpdir/"

cd "$tmpdir"
git config user.name "gotar-deploy"
git config user.email "deploy@users.noreply.github.com"
git add -A

if git diff --cached --quiet; then
  echo "No changes to deploy"
  exit 0
fi

git commit -m "Deploy GitHub Pages (local)"
git push origin HEAD:gh-pages
echo "✅ Pushed to gh-pages."

# Verify live: poll until the new stylesheet version is served.
VERIFY_URL="${DEPLOY_VERIFY_URL:-https://aikido-polska.eu/}"
TIMEOUT="${DEPLOY_VERIFY_TIMEOUT:-300}"
if [ -z "$EXPECTED" ]; then
  echo "⚠️  No stylesheet version in build/index.html — skipping live verification."
  exit 0
fi
deadline=$(( $(date +%s) + TIMEOUT ))
until curl -fsS "$VERIFY_URL?cb=$(date +%s)" -o /tmp/deploy-verify.html 2>/dev/null \
      && grep -q "style.css?v=$EXPECTED" /tmp/deploy-verify.html; do
  if [ "$(date +%s)" -ge "$deadline" ]; then
    echo "❌ Not live after ${TIMEOUT}s: expected style.css?v=$EXPECTED on $VERIFY_URL" >&2
    exit 1
  fi
  sleep 15
done
echo "✅ Live: style.css?v=$EXPECTED on $VERIFY_URL"
