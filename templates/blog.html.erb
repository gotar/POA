<% page_title "Blog | Polska Organizacja Aikido" if blog_current_page == 1 %>

<div class="content">
  <div class="article">
    <h1>Blog</h1>
    <% if blog_current_page == 1 %>
      <p class="lead">
        Zapisy z praktyki i filozofii aikido: technika, praca wewnętrzna i życie dojo
        — od pierwszego treningu po zasady, które porządkują ruch i uwagę.
      </p>

      <section class="blog-start-here" aria-labelledby="blog-start-here-heading">
        <h2 id="blog-start-here-heading">Zacznij tutaj</h2>
        <p>Cztery teksty na początek — czym jest aikido, dla kogo i czy warto zacząć:</p>
        <ul>
          <% blog_featured_posts(language: "pl", limit: 4).each do |post| %>
            <li><a href="<%= post[:url] %>"><%= post[:title] %></a></li>
          <% end %>
        </ul>
      </section>
    <% else %>
      <p class="lead">Starsze wpisy (strona <%= blog_current_page %>).</p>
    <% end %>

    <div class="news-list">
      <% blog_posts_for_current_page.each do |post| %>
        <article class="news-card">
          <div class="news-meta"><%= post[:date] %></div>
          <p class="news-category"><%= blog_category_label(post[:category], "pl") %></p>
          <h2><a class="news-card-title" href="<%= post[:url] %>"><%= post[:title] %></a></h2>
          <p><%= post[:summary] %></p>
          <a class="news-read-more" href="<%= post[:url] %>" aria-label="<%= read_more_aria_label(post[:title]) %>">Czytaj więcej →</a>
        </article>
      <% end %>
    </div>

    <% if blog_total_pages > 1 %>
      <nav class="pagination" aria-label="Paginacja bloga">
        <% if blog_current_page > 1 %>
          <a class="pagination-link pagination-prev" href="<%= blog_page_path(blog_current_page - 1) %>">← Poprzednia</a>
        <% end %>

        <% blog_page_numbers.each do |page| %>
          <% if page == blog_current_page %>
            <span class="pagination-link is-active" aria-current="page"><%= page %></span>
          <% else %>
            <a class="pagination-link" href="<%= blog_page_path(page) %>"><%= page %></a>
          <% end %>
        <% end %>

        <% if blog_current_page < blog_total_pages %>
          <a class="pagination-link pagination-next" href="<%= blog_page_path(blog_current_page + 1) %>">Następna →</a>
        <% end %>
      </nav>
    <% end %>

    <script type="application/json" id="blog-index" data-lang="pl"><%= blog_index_json_safe(language: "pl") %></script>
  </div>
</div>
