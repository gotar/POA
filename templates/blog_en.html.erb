<% page_title "Blog | Polish Aikido Organization" if blog_current_page == 1 %>

<div class="content">
  <div class="article">
    <h1>Blog</h1>
    <% if blog_current_page == 1 %>
      <p class="lead">
        Notes on aikido practice and philosophy: technique, inner work, and dojo life
        — from the first training to the principles that order movement and attention.
      </p>

      <section class="blog-start-here" aria-labelledby="blog-start-here-heading">
        <h2 id="blog-start-here-heading">Start here</h2>
        <p>Four texts to begin with — what aikido is, who it is for, and whether it is worth starting:</p>
        <ul>
          <% blog_featured_posts(language: "en", limit: 4).each do |post| %>
            <li><a href="<%= post[:url] %>"><%= post[:title] %></a></li>
          <% end %>
        </ul>
      </section>
    <% else %>
      <p class="lead">Older posts (page <%= blog_current_page %>).</p>
    <% end %>

    <div class="news-list">
      <% blog_posts_for_current_page.each do |post| %>
        <article class="news-card">
          <div class="news-meta"><%= post[:date] %></div>
          <p class="news-category"><%= blog_category_label(post[:category], "en") %></p>
          <h2><a class="news-card-title" href="<%= post[:url] %>"><%= post[:title] %></a></h2>
          <p><%= post[:summary] %></p>
          <a class="news-read-more" href="<%= post[:url] %>" aria-label="<%= read_more_aria_label(post[:title]) %>">Read more →</a>
        </article>
      <% end %>
    </div>

    <% if blog_total_pages > 1 %>
      <nav class="pagination" aria-label="Blog pagination">
        <% if blog_current_page > 1 %>
          <a class="pagination-link pagination-prev" href="<%= blog_page_path(blog_current_page - 1) %>">← Previous</a>
        <% end %>

        <% blog_page_numbers.each do |page| %>
          <% if page == blog_current_page %>
            <span class="pagination-link is-active" aria-current="page"><%= page %></span>
          <% else %>
            <a class="pagination-link" href="<%= blog_page_path(page) %>"><%= page %></a>
          <% end %>
        <% end %>

        <% if blog_current_page < blog_total_pages %>
          <a class="pagination-link pagination-next" href="<%= blog_page_path(blog_current_page + 1) %>">Next →</a>
        <% end %>
      </nav>
    <% end %>

    <script type="application/json" id="blog-index" data-lang="en"><%= blog_index_json_safe(language: "en") %></script>
  </div>
</div>
