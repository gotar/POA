<% page_title "Wydarzenia | 2026" %>
<%= event_schema(
  name: "BAA Seminars 2026 - Bulgarian Aikido Association",
  start_date: "2026-02-28",
  end_date: "2026-12-09",
  location: {
    name: "Bulgarian Aikido Association",
    street: "Various locations",
    city: "Bulgaria and International",
    country: "BG"
  },
  description: "Program seminariow i obozow Bulgarian Aikido Association (BAA) na rok 2026 pod kierownictwem Germanov Shihan. Seminaria, obozy i szkolenia Aikido w Europie i USA.",
  image: "#{site_url}#{asset_path('images/toyoda.svg')}",
  lang: "pl"
) %>
<div class="content">
  <div class="article">
    <h1>Wydarzenia</h1>
    <h2>Program seminariów Germanov Shihan i BAA na 2026</h2>

    <p>
      Program seminariów i obozów Bulgarian Aikido Association (BAA) na rok 2026
      pod kierownictwem Germanov Shihan.
    </p>

    <nav class="events-index" aria-label="Na tej stronie">
      <ul class="inline">
        <li><a href="#nadchodzace">Nadchodzące wydarzenia</a></li>
        <li><a href="#archiwum">Archiwum</a></li>
      </ul>
    </nav>

    <section class="events-section" aria-labelledby="nadchodzace">
      <h2 id="nadchodzace" tabindex="-1">Nadchodzące wydarzenia</h2>
      <% upcoming = events_2026_upcoming %>
      <% if upcoming.empty? %>
        <p class="events-empty">Aktualnie nie ma ogłoszonych nadchodzących wydarzeń. Zajrzyj do archiwum poniżej albo wróć później — nowe terminy pojawią się tutaj.</p>
      <% else %>
        <table class="events-table">
          <thead>
            <tr>
              <th scope="col">Data</th>
              <th scope="col">Wydarzenie</th>
              <th scope="col">Lokalizacja</th>
              <th scope="col">Instruktor</th>
            </tr>
          </thead>
          <tbody>
            <% upcoming.each do |entry| %>
              <tr>
                <td data-label="Data"><%= entry[:date] %></td>
                <td data-label="Wydarzenie"><%= entry[:event] %></td>
                <td data-label="Lokalizacja"><%= entry[:location] %></td>
                <td data-label="Instruktor"><%= entry[:instructor] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </section>

    <section class="events-section" aria-labelledby="archiwum">
      <h2 id="archiwum" tabindex="-1">Archiwum</h2>
      <table class="events-table">
        <thead>
          <tr>
            <th scope="col">Data</th>
            <th scope="col">Wydarzenie</th>
            <th scope="col">Lokalizacja</th>
            <th scope="col">Instruktor</th>
          </tr>
        </thead>
        <tbody>
          <% events_2026_archive.each do |entry| %>
            <tr>
              <td data-label="Data"><%= entry[:date] %></td>
              <td data-label="Wydarzenie"><%= entry[:event] %></td>
              <td data-label="Lokalizacja"><%= entry[:location] %></td>
              <td data-label="Instruktor"><%= entry[:instructor] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>

  </div>
</div>
