<% page_title "Events | 2026" %>

<div class="content">
  <div class="article">
    <h1>Events</h1>
    <h2>Germanov Shihan and BAA Seminar Program for 2026</h2>

    <p>
      Bulgarian Aikido Association (BAA) seminar and camp program for 2026
      under the leadership of Germanov Shihan.
    </p>

    <nav class="events-index" aria-label="On this page">
      <ul class="inline">
        <li><a href="#upcoming">Upcoming events</a></li>
        <li><a href="#archive">Archive</a></li>
      </ul>
    </nav>

    <section class="events-section" aria-labelledby="upcoming">
      <h2 id="upcoming" tabindex="-1">Upcoming events</h2>
      <% upcoming = events_2026_upcoming %>
      <% if upcoming.empty? %>
        <p class="events-empty">There are currently no announced upcoming events. Browse the archive below or check back later — new dates will appear here.</p>
      <% else %>
        <p>The nearest event carries the “Next” label.</p>
        <table class="events-table">
          <thead>
            <tr>
              <th scope="col">Date</th>
              <th scope="col">Event</th>
              <th scope="col">Location</th>
              <th scope="col">Instructor</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            <% upcoming.each do |entry| %>
              <tr<%= ' class="special event-next"' if entry[:nearest] %>>
                <td data-label="Date"><%= entry[:date] %></td>
                <td data-label="Event"><%= entry[:event] %></td>
                <td data-label="Location"><%= entry[:location] %></td>
                <td data-label="Instructor"><%= entry[:instructor] %></td>
                <td data-label="Status"><span class="status-badge <%= event_status_class(entry) %>"><%= event_status_label(entry, "en") %></span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </section>

    <section class="events-section" aria-labelledby="archive">
      <h2 id="archive" tabindex="-1">Archive</h2>
      <p>Past events — each one carries the “Past” label.</p>
      <table class="events-table">
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Event</th>
            <th scope="col">Location</th>
            <th scope="col">Instructor</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% events_2026_archive.each do |entry| %>
            <tr class="past">
              <td data-label="Date"><%= entry[:date] %></td>
              <td data-label="Event"><%= entry[:event] %></td>
              <td data-label="Location"><%= entry[:location] %></td>
              <td data-label="Instructor"><%= entry[:instructor] %></td>
              <td data-label="Status"><span class="status-badge <%= event_status_class(entry) %>"><%= event_status_label(entry, "en") %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>

  </div>
</div>
